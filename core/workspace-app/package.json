{
  "name": "@webship/workspace",
  "version": "1.0.0",
  "description": "The Webship Workspace dashboard: a lean core (workspaces, builders, settings, the assistant shell, the plugin system) that every feature joins as a @webship/workspace-<name> plugin \u2014 required with npm, then activated, installed and configured.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace.git",
    "directory": "core/workspace-app"
  },
  "main": "server.js",
  "files": [
    "*.js",
    "actions",
    "commands",
    "docs",
    "public",
    "scripts",
    "plugins/workspace-notes",
    "screenrc",
    "PLUGINS.md",
    "WORKSPACES.md",
    "README.md"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"tests/unit/*.test.js\" \"plugins/*/tests/*.test.js\"",
    "test:browser": "cucumber-js --config cucumber.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ace-builds": "^1.44.0",
    "htmx.org": "^4.0.0",
    "js-yaml": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "webship-js": "^2.0.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "author": ""
}
