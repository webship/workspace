{
  "name": "workspace-dashboard",
  "version": "1.0.44",
  "description": "The Webship Workspace dashboard: a lean core (workspaces, builders, settings, the assistant shell, the plugin system) that every feature joins as a @webship.co/workspace-<name> plugin — required with npm, then activated, installed and configured.",
  "license": "ISC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/*.test.mts $(ls plugins/*/tests/*.test.js 2>/dev/null)",
    "test:browser": "cucumber-js --config cucumber.js",
    "typecheck": "tsc -p . && tsc -p src/browser && tsc -p src/browser/ui",
    "build:browser": "node scripts/build-browser.mts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ace-builds": "^1.44.0",
    "htmx.org": "^4.0.0",
    "js-yaml": "^5.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "webship-js": "^2.0.17"
  },
  "keywords": [],
  "author": "",
  "private": true
}
