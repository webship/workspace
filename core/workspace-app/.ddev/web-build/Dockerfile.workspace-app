# Docker-outside-of-Docker: install a docker CLI (talks to the host's
# docker.sock, bind-mounted in via docker-compose.dood.yaml) and the ddev
# binary itself, so cmd-*.sh scripts run from inside this container can
# manage sibling ddev projects exactly like they do on the host.
RUN apt-get update -o Acquire::AllowInsecureRepositories=true || true \
    && apt-get install -y --no-install-recommends --allow-unauthenticated docker.io curl ca-certificates \
       pandoc wkhtmltopdf \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://github.com/ddev/ddev/releases/download/v1.24.7/ddev_linux-amd64.v1.24.7.tar.gz \
    -o /tmp/ddev.tar.gz \
    && tar -xzf /tmp/ddev.tar.gz -C /tmp \
    && mv /tmp/ddev /usr/local/bin/ddev \
    && chmod +x /usr/local/bin/ddev \
    && rm -rf /tmp/ddev.tar.gz

# Claude Code CLI for the AI assistant chat (/actions/chat shells out to
# `claude -p`). Auth comes from the host's ~/.claude + ~/.claude.json,
# bind-mounted in via docker-compose.dood.yaml.
RUN npm install -g @anthropic-ai/claude-code

# graphify (github.com/Graphify-Labs/graphify) parses a codebase with tree-sitter into a knowledge
# graph. Installed with uv rather than pip: this base image has no pip at all, and Debian's python
# is externally managed (PEP 668), so a virtual environment is the supported way in — which is what
# `uv tool install` makes. Pinned, because graphify's node-id scheme changed inside 0.9.x and its
# CLI ignores unknown flags, so an unpinned upgrade degrades quietly instead of failing.
#
# The mcp extra is pinned below 2 separately: graphify 0.9.28 imports `AnyUrl` from a module mcp
# 2.x moved, and the failure surfaces only as "Connection closed" from whatever tries to use it.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && UV_TOOL_BIN_DIR=/usr/local/bin UV_TOOL_DIR=/opt/uv-tools \
       uv tool install 'graphifyy[sql]==0.9.28' --with 'mcp<2' \
    && graphify --version

# The browser webship-js drives, plus the system libraries it needs. Chromium only: the suite
# asserts behaviour, not rendering differences between engines.
#
# The apt dance is the same one the automated-testing builder does: a third-party PHP repository
# with an expired signing key is enabled in this image, and `apt-get update` fails while it is —
# which makes playwright's own dependency install fail with a message about chromium rather than
# about apt. The list is parked for the install and put straight back.
#
# playwright-core rather than the playwright CLI: the package that ships the browser downloader is
# already a dependency of webship-js, so nothing extra is installed to install it.
RUN npm install -g playwright-core@1.56.0 \
    && mkdir -p /tmp/apt-off \
    && (mv /etc/apt/sources.list.d/php.list /tmp/apt-off/ 2>/dev/null || true) \
    && apt-get update -qq \
    && npx --yes playwright-core@1.56.0 install --with-deps chromium \
    && (mv /tmp/apt-off/php.list /etc/apt/sources.list.d/ 2>/dev/null || true) \
    && rm -rf /var/lib/apt/lists/*

# The host's /var/run/docker.sock (bind-mounted in) is owned by root:docker
# with the HOST's docker group GID — find yours with `getent group docker`
# and adjust the 984 below if it differs. It must be the web user's PRIMARY
# group, not just a supplementary one: supervisord (which launches
# web_extra_daemons) drops privileges without calling initgroups(), so
# supplementary groups from /etc/group never apply to the daemon process —
# only the primary GID from passwd does. ($username is provided by DDEV's
# base image build args and matches your host username.)
RUN groupmod -g 984 docker && usermod -g 984 $username
