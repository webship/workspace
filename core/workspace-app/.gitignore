# A test run writes its report here; it is evidence of one run, not source.
tests/reports/
tests/screenshots/
tests/videos/

# The checks verb writes a small marker per project here so the dashboard can caption its button.
# It names real projects and belongs to this machine, exactly like core/config/settings.yml.
core/state/

# Playwright MCP writes page snapshots and screenshots here; evidence of a run, not source.
.playwright-mcp/

# Dashboard error and event log: this machine only.
logs/
