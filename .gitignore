# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env
/nbproject
/nbproject/
/nbproject/private/
# Node dependencies (workspace-app)
node_modules/

# graphify knowledge graphs are generated per project, are large (tens of MB),
# and Leiden clustering is not bit-stable, so they diff fully on every rebuild.
graphify-out/

# The dev-ai-agents checkout cmd-tools-ai-items.sh keeps for syncing.
ai-agents/dev-ai-agents/
ai-skills/dev-ai-agents/
ai-prompts/dev-ai-agents/
specs/dev-ai-agents/

# The commands workspace keeps a mirror of the tooling repository to compare
# against. Tens of MB, and it is a checkout, not source.
commands/workspace-repo/

# Playwright MCP writes page snapshots into the working directory when the
# dashboard is driven from a browser session. Session artefacts, not source.
.playwright-mcp/

# The Web IDE keeps its user data, settings and installed extensions here, so they
# survive an image rebuild. Machine state, never committed.
.code-server/

# The release a machine is on. Written by install.sh, sync-tooling.sh --pull and update.sh;
# it describes THIS machine, so it is never committed.
core/workspace-app/.app-version

# The assistant's conversations: what was typed into the chat, on this machine. Runtime state like
# actions.log, and it is a chat log — never committed, never synced.
core/workspace-app/.chats/
core/workspace-app/.memory/
core/workspace-app/.voice-cache/
core/workspace-app/.auth/

# The dashboard runtime state: screen logs and the text a voice is made from.
.screens/

# The images workspace's pictures are the user's, not tooling; only its docs are committed.
/images/*
!/images/README.md
!/images/AGENTS.md
!/images/CLAUDE.md

# Thumbnails the images gallery makes, kept to be fast the next time.
core/workspace-app/.cache/

# The dashboard's mounts for the second storage, written by core/scripts/storage.sh --mounts from
# this machine's storage.second. Machine paths, never committed.
core/workspace-app/.ddev/docker-compose.second-storage.yaml

# plugins — managed by core/scripts/plugins.sh; do not edit between the markers
/core/config/plugin.upsun.settings.yml
/core/config/plugins.installed.yml
/core/config/theme.upsun.yml
/core/scripts/plugins/
/core/scripts/plugins/upsun/args/arg-upsun.sh
/core/scripts/plugins/upsun/functions/fun-upsun.sh
/core/scripts/plugins/upsun/host-install.sh
/core/scripts/plugins/upsun/host-mounts.txt
/core/scripts/plugins/upsun/upsun-ai.sh
/core/workspace-app/.ddev/docker-compose.plugin-upsun-upsun-cli.yaml
/demos/cmd-tools-upsun.sh
/dev/cmd-tools-upsun.sh
/projects/cmd-tools-upsun.sh
/sandboxes/cmd-tools-upsun.sh
/test/cmd-tools-upsun.sh
# end plugins
